{
  "expo": {
    "name": "Transakt",
    "slug": "transakt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.svg",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.svg",
      "resizeMode": "contain",
      "backgroundColor": "#18140F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.transakt.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.svg",
        "backgroundColor": "#18140F"
      },
      "package": "com.transakt.app"
    },
    "web": {
      "favicon": "./assets/favicon.svg",
      "bundler": "metro"
    }
  }
}
